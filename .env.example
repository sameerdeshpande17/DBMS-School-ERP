# MySQL 8.4 primary database (local development instance)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=school_app
DB_PASSWORD=YOUR_PRIVATE_PASSWORD
DB_NAME=school_erp

# Alternatively, configure a single connection string instead of DB_* values:
# DATABASE_URL=mysql://school_app:YOUR_PRIVATE_PASSWORD@127.0.0.1:3307/school_erp

# Redis Stack secondary document/vector store
REDIS_URL=redis://127.0.0.1:6379

# Generate a long random value; keep this secret out of Git
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
